---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { nav, freeLine, phones, feedbackPhone, SOON } from "../data/site";
---
<header class="site-header on-field" data-rec="W-R002,W-R004">
  <div class="container site-header__bar">
    <a class="site-header__logo" href="#top" aria-label="Eparts, на початок сторінки">
      <img src="/eparts-logo.svg" alt="Eparts" width="62" height="49" />
    </a>

    <nav class="site-nav" aria-label="Розділи сторінки">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="site-header__phone tel" href={freeLine.href}>
        <Icon name="phone" />
        <span class="num">{freeLine.display}</span>
      </a>
      <div class="lang" aria-label="Мова сайту" role="group">
        <span class="lang__item lang__item--on" aria-current="true" lang="uk">UA</span>
        <FutureLink note={SOON} class="lang__item future-link--right"><span lang="ru">RU</span></FutureLink>
      </div>
      <FutureLink note={SOON} class="site-header__cart future-link--right">
        <Icon name="cart" /><span class="visually-hidden">Кошик</span>
      </FutureLink>
    </div>

    <a class="site-header__call" href={freeLine.href} aria-label={`Подзвонити безкоштовно ${freeLine.display}`}>
      <Icon name="phone" /><span>0-800</span>
    </a>

    <details class="mnav" data-mnav>
      <summary class="mnav__toggle" aria-label="Меню">
        <Icon name="menu" class="mnav__open" /><Icon name="close" class="mnav__close" />
      </summary>
      <div class="mnav__panel">
        <ul class="mnav__links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
        <ul class="mnav__phones">
          <li><a class="tel" href={freeLine.href}>{freeLine.display}</a><span>{freeLine.note}</span></li>
          {phones.map((p) => <li><a class="tel" href={p.href}>{p.display}</a><span>{p.label}</span></li>)}
          <li><a class="tel" href={feedbackPhone.href}>{feedbackPhone.display}</a><span>{feedbackPhone.label}</span></li>
        </ul>
        <div class="lang lang--menu" aria-label="Мова сайту" role="group">
          <span class="lang__item lang__item--on" aria-current="true" lang="uk">UA</span>
          <FutureLink note={SOON} class="lang__item future-link--up"><span lang="ru">RU</span></FutureLink>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: var(--color-field); color: var(--color-on-field);
    border-bottom: 1px solid var(--color-text);
  }
  .site-header__bar {
    display: flex; align-items: center; gap: var(--space-4);
    min-height: var(--header-h);
  }
  .site-header__logo { display: block; flex: none; margin-right: auto; padding-block: var(--space-1); }
  .site-header__logo img { width: 52px; height: auto; }

  .site-nav, .site-header__tools { display: none; }

  .site-header__call {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px; padding: 0 var(--space-3);
    border: 1.5px solid var(--color-accent); border-radius: var(--radius);
    color: var(--color-on-field); font-weight: 600; text-decoration: none; white-space: nowrap;
  }
  .site-header__call :global(.icon) { color: var(--color-accent); }

  .mnav__toggle {
    display: grid; place-items: center; width: 44px; height: 44px;
    list-style: none; cursor: pointer; border-radius: var(--radius);
  }
  .mnav__toggle::-webkit-details-marker { display: none; }
  .mnav__toggle :global(.icon) { width: 26px; height: 26px; }
  .mnav :global(.mnav__close) { display: none; }
  .mnav[open] :global(.mnav__open) { display: none; }
  .mnav[open] :global(.mnav__close) { display: block; }
  .mnav:not([open]) .mnav__panel { display: none; }
  .mnav__panel {
    position: absolute; left: 0; right: 0; top: 100%;
    max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
    padding: var(--space-4) var(--gutter) var(--space-6);
    background: var(--color-field); border-top: 1px solid var(--color-text-muted);
  }
  .mnav__links a {
    display: flex; align-items: center; min-height: 48px;
    font-family: var(--font-display); font-size: var(--text-title); text-decoration: none;
  }
  .mnav__links a:hover { color: var(--color-accent); }
  .mnav__phones { display: grid; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--color-text-muted); }
  .mnav__phones li { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-3); }
  .mnav__phones .tel { display: inline-flex; align-items: center; min-height: 40px; font-size: var(--text-lead); }
  .mnav__phones span { color: var(--color-on-field-muted); font-size: var(--text-small); }

  .lang { display: flex; align-items: center; gap: var(--space-1); font-size: var(--text-small); font-weight: 600; }
  .lang--menu { margin-top: var(--space-5); }
  .lang :global(.lang__item) { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; padding: 0 var(--space-2); border-radius: var(--radius-s); color: var(--color-on-field-muted); }
  .lang .lang__item--on { color: var(--color-on-field); box-shadow: inset 0 -2px 0 var(--color-accent); }

  @media (min-width: 64rem) {
    .site-header__logo { margin-right: 0; }
    .site-header__logo img { width: 62px; }
    .site-header__call, .mnav { display: none; }
    .site-nav { display: block; margin-left: var(--space-5); margin-right: auto; }
    .site-nav ul { display: flex; gap: var(--space-1); }
    .site-nav a {
      display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-2);
      font-size: 0.9375rem; font-weight: 600; text-decoration: none; white-space: nowrap; color: var(--color-on-field);
      border-radius: var(--radius-s);
      background-image: linear-gradient(var(--color-accent), var(--color-accent));
      background-size: 0 2px; background-repeat: no-repeat; background-position: var(--space-2) 80%;
    }
    .site-nav a:hover { color: var(--color-on-field); background-size: calc(100% - 2 * var(--space-2)) 2px; }
    .site-header__tools { display: flex; align-items: center; gap: var(--space-4); }
    .site-header__phone { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; }
    .site-header__phone :global(.icon) { color: var(--color-accent); }
    .site-header__tools :global(.site-header__cart) { width: 44px; height: 44px; justify-content: center; color: var(--color-on-field-muted); }
  }
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .site-header__bar { gap: var(--space-2); }
    .site-nav { margin-left: var(--space-2); }
    .site-nav ul { gap: 0; }
    .site-nav a { font-size: var(--text-small); padding: 0 var(--space-2); }
    .site-header__tools { gap: var(--space-2); }
  }
  @media (min-width: 80rem) {
    .site-nav ul { gap: var(--space-3); }
  }
</style>

<script>
  // Close the phone menu after an anchor is chosen, and on Escape.
  const menu = document.querySelector<HTMLDetailsElement>("[data-mnav]");
  if (menu) {
    menu.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener("click", () => { menu.open = false; }));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
    });
  }
</script>
