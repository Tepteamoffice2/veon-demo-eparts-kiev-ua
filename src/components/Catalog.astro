---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { catalog, freeLine, SOON } from "../data/site";
---
<section id="catalog" class="section catalog" aria-labelledby="catalog-title" data-rec="W-R005">
  <div class="container">
    <div class="section__head">
      <h2 id="catalog-title">Каталог за вузлами авто</h2>
      <p class="section__lead">12 категорій у чотирьох групах: від запчастин для ТО до кузова й світла.</p>
    </div>
    <div class="catalog__grid">
      {catalog.map((g) => (
        <div class="catalog__group">
          <h3>{g.group}</h3>
          <ul>
            {g.items.map((it) => (
              <li><FutureLink note={SOON} class="index-link">{it}<Icon name="arrow" class="index-link__arrow" /></FutureLink></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="catalog__call">Не впевнені, до якого вузла належить деталь? Менеджер підбере по телефону <a class="tel" href={freeLine.href}>{freeLine.display}</a></p>
  </div>
</section>

<style>
  .catalog__grid {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6) var(--col-gap);
  }
  .catalog__group { border-top: 1px solid var(--color-rule); padding-top: var(--space-4); }
  .catalog__group h3 { margin-bottom: var(--space-3); }
  .catalog__group ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-4); }
  .catalog__group :global(.index-link) {
    display: flex; align-items: flex-start; justify-content: flex-start; gap: var(--space-2);
    min-height: 44px; padding-block: var(--space-3);
    font-size: var(--text-index); line-height: 1.3;
  }
  .catalog__group :global(.index-link__arrow) {
    width: 18px; height: 18px; margin-top: 0.15em; color: var(--color-link);
    transition: transform var(--dur-short) var(--ease-out);
  }
  @media (hover: hover) {
    .catalog__group :global(.index-link:hover .index-link__arrow) { transform: translateX(4px); }
  }
  
  .catalog__call { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-rule); color: var(--color-text-muted); }

  @media (min-width: 40rem) {
    .catalog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .catalog__group ul { grid-template-columns: minmax(0, 1fr); }
  }
  @media (min-width: 60rem) {
    .catalog__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
